{
  "manifest_version": 3,
  "name": "UniMercatorum Suite (Dispense & Video Auto-Player)",
  "version": "1.1.0",
  "description": "Scarica automaticamente tutte le dispense PDF ed esegue la riproduzione sequenziale con avanzamento automatico al 100% dei video didattici UniMercatorum.",
  "permissions": [
    "storage",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "*://lms.mercatorum.multiversity.click/*",
    "*://*.multiversity.click/*",
    "*://*.unimercatorum.it/*"
  ],
  "action": {
    "default_title": "UniMercatorum Dispense Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://lms.mercatorum.multiversity.click/*",
        "*://*.multiversity.click/*",
        "*://*.unimercatorum.it/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://lms.mercatorum.multiversity.click/*",
        "*://*.multiversity.click/*",
        "*://*.unimercatorum.it/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["bridge.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
